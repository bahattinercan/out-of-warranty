{
  "appId": "com.bahattinercan.outofwarranty",
  "appName": "Out of Warranty",
  "webDir": "dist/android-web",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
